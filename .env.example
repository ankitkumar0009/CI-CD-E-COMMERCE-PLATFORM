PROJECT_NAME=E-Commerce Product and Order Management API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Local machine connection (e.g. when port-forwarded from Docker):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecommerce_db
# Container connection string inside docker network (used by docker-compose):
# postgresql+psycopg://postgres:postgres@postgres:5432/ecommerce_db

# Security & Authentication
JWT_SECRET_KEY=94c2e64627885b59e38e83bfa867201c7471927c34b6e5b5e7d581c81ef4f1d2
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (Created by database seed script)
ADMIN_DEFAULT_EMAIL=admin@ecommerce.local
ADMIN_DEFAULT_PASSWORD=AdminSecret2026!

# Logging & Monitoring
LOG_LEVEL=INFO
ENABLE_PROMETHEUS=true

